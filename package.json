{
  "name": "sabishii-me-agent-hub",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "description": "A local hub that manages agent harnesses: one HTTP+SSE surface on loopback, one plugin per harness.",
  "repository": "sabishii-me/agent-hub",
  "bin": {
    "agent-hub": "./cli.mjs"
  },
  "scripts": {
    "serve": "node server.mjs",
    "cli": "node cli.mjs",
    "pack": "node scripts/pack-plugins.mjs --write && node scripts/record-runtime.mjs --write",
    "pack:runtime": "node scripts/record-runtime.mjs --write",
    "pack:hub": "node scripts/pack-hub.mjs",
    "test": "node tests/run.mjs"
  }
}
