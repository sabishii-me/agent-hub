# A plugin's runtime is an official release installed from its package
# (manifest.runtime.package + .version), prepared by scripts/prepare-runtimes.mjs:
# a build product, never committed.
plugins/*/runtime/

node_modules/
build-id.json
.vscode/
.DS_Store
*.log

# Build output: the plugin zips pack-plugins.mjs writes. Publishing uploads
# them to each plugin's own GitHub Release; the registry names those URLs, so
# no build product belongs in this repository.
dist/

# Rust build output.
/target/

# Python test caches
tests/**/__pycache__/
__pycache__/
*.pyc
